{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usserschwyz-athletics",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
  // Speicher für News und Instagram: nach dem Erstellen des KV-Namespace hier eintragen
  // "kv_namespaces": [{ "binding": "UA_DATA", "id": "<ID aus Cloudflare>" }]
}
