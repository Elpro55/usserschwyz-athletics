{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usserschwyz-athletics",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Speicher für Termine, News und Instagram (Namespace "ua-data")
  "kv_namespaces": [{ "binding": "UA_DATA", "id": "eb44a99cdcb2439eaf88649bf467f4c7" }],
  // Admin-Passwort wird als Secret ADMIN_PASSWORD im Cloudflare-Dashboard gesetzt
  "keep_vars": true
}
